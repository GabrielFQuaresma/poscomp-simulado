dist/
.DS_Store
*.log

# credenciais locais. A chave anonima do Supabase e publica por design (vai no
# bundle de qualquer forma), mas este arquivo nao deve ser versionado: e onde
# uma chave de servico acabaria parando por engano.
.env
.env.*
!.env.example

# pipeline working area (source PDFs cloned locally, not committed)
pipeline/source/
pipeline/.venv/
pipeline/__pycache__/
pipeline/**/__pycache__/
pipeline/qa/

# classify.py working output: per-question extracted text + incidence report,
# regenerated on every run and only used to review the classifier's decisions
pipeline/text/
pipeline/topics_report.txt
